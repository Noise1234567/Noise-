// Schéma Prisma de Noise (NOISE-006). Source : docs/database.md, DEC-007, DEC-022.
// Conventions : modèles en PascalCase, tables et colonnes en snake_case (@@map / @map),
// identifiants UUID, dates en timestamptz (UTC), montants en Int (FCFA, pas de décimales).
// Les contraintes CHECK (quantités, montants) sont ajoutées en SQL dans la migration :
// Prisma ne sait pas les exprimer dans le schéma.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Valeurs identiques à packages/shared/src/domain.ts.

enum UserRole {
  PARTICIPANT
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
}

enum MobileMoneyOperator {
  MTN
  MOOV
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum ScanResult {
  ACCEPTED
  ALREADY_USED
  INVALID
  CANCELLED
  WRONG_EVENT
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(80)
  /// E.164 : +229 suivi de 10 chiffres, soit 14 caractères (normalisé par packages/shared/src/phone.ts).
  phone        String     @unique @db.VarChar(16)
  /// Minuscules (CHECK en base). Nul pour les comptes créés avant DEC-026 ; obligatoire à l'inscription.
  email        String?    @unique @db.VarChar(254)
  passwordHash String     @map("password_hash")
  roles        UserRole[]
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens      RefreshToken[]
  organizedEvents    Event[]
  orders             Order[]        @relation("participant")
  referredOrders     Order[]        @relation("referrer")
  createdScannerLink ScannerLink[]
  pushTokens         PushToken[]

  @@map("users")
}

/// Rotation : à chaque refresh, l'ancien jeton est révoqué et remplacé (replacedById).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 hexadécimal du jeton ; le jeton lui-même n'est jamais stocké.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// « À venir / passé » est calculé à partir de startsAt / endsAt, pas stocké.
model Event {
  id                 String      @id @default(uuid()) @db.Uuid
  organizerId        String      @map("organizer_id") @db.Uuid
  title              String      @db.VarChar(120)
  description        String
  genre              String      @db.VarChar(40)
  venue              String      @db.VarChar(120)
  city               String      @db.VarChar(60)
  startsAt           DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime    @map("ends_at") @db.Timestamptz(3)
  posterUrl          String?     @map("poster_url")
  status             EventStatus @default(DRAFT)
  /// Affiliation (DEC-022, après le MVP) : 1 % pour le partageur si l'organisateur l'accepte.
  affiliationEnabled Boolean     @default(false) @map("affiliation_enabled")
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizer    User          @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTypes  TicketType[]
  tickets      Ticket[]
  scannerLinks ScannerLink[]

  @@index([status, startsAt])
  @@index([organizerId])
  @@index([genre, city])
  @@map("events")
}

model TicketType {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  name          String    @db.VarChar(60)
  priceXof      Int       @map("price_xof")
  quantityTotal Int       @map("quantity_total")
  /// Incrémenté à la confirmation du paiement, jamais à la création de commande (CDC 6.2).
  quantitySold  Int       @default(0) @map("quantity_sold")
  salesEndAt    DateTime? @map("sales_end_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders  Order[]
  tickets Ticket[]

  @@unique([eventId, name])
  @@map("ticket_types")
}

/// PENDING réserve le stock jusqu'à expiresAt (DEC-007). Prix figé à la création.
model Order {
  id                String      @id @default(uuid()) @db.Uuid
  participantId     String      @map("participant_id") @db.Uuid
  ticketTypeId      String      @map("ticket_type_id") @db.Uuid
  quantity          Int
  unitPriceXof      Int         @map("unit_price_xof")
  totalXof          Int         @map("total_xof")
  status            OrderStatus @default(PENDING)
  expiresAt         DateTime    @map("expires_at") @db.Timestamptz(3)
  paidAt            DateTime?   @map("paid_at") @db.Timestamptz(3)
  /// Partageur dont le lien a mené à l'achat (DEC-022, après le MVP).
  referrerId        String?     @map("referrer_id") @db.Uuid
  /// Registre de la répartition (DEC-022), écrit à la confirmation du paiement (NOISE-019).
  noiseShareXof     Int?        @map("noise_share_xof")
  affiliateShareXof Int?        @map("affiliate_share_xof")
  organizerShareXof Int?        @map("organizer_share_xof")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant User       @relation("participant", fields: [participantId], references: [id], onDelete: Restrict)
  referrer    User?      @relation("referrer", fields: [referrerId], references: [id], onDelete: SetNull)
  ticketType  TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  payments    Payment[]
  tickets     Ticket[]

  @@index([status, expiresAt])
  @@index([ticketTypeId, status])
  @@index([participantId])
  @@map("orders")
}

/// Une commande peut avoir plusieurs tentatives de paiement.
model Payment {
  id                    String              @id @default(uuid()) @db.Uuid
  orderId               String              @map("order_id") @db.Uuid
  provider              String              @db.VarChar(20)
  operator              MobileMoneyOperator
  /// Jamais le numéro complet : format 0197****47.
  phoneMasked           String              @map("phone_masked") @db.VarChar(20)
  amountXof             Int                 @map("amount_xof")
  status                PaymentStatus       @default(INITIATED)
  /// Unique : un webhook rejoué ne peut pas confirmer deux fois (idempotence).
  providerTransactionId String?             @unique @map("provider_transaction_id") @db.VarChar(64)
  rawStatus             String?             @map("raw_status") @db.VarChar(40)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("payments")
}

/// Créé uniquement à la confirmation du paiement.
model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  ticketTypeId String       @map("ticket_type_id") @db.Uuid
  eventId      String       @map("event_id") @db.Uuid
  holderName   String       @map("holder_name") @db.VarChar(80)
  /// SHA-256 hexadécimal du QR ; le QR lui-même n'est jamais stocké.
  qrTokenHash  String       @unique @map("qr_token_hash") @db.Char(64)
  status       TicketStatus @default(VALID)
  /// Heure d'entrée : écrite dans la même transaction que status = USED (NOISE-025).
  usedAt       DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  scanLogs   ScanLog[]

  @@index([eventId, status])
  @@index([eventId, usedAt])
  @@index([orderId])
  @@map("tickets")
}

/// Le JWT du lien n'est pas stocké : seul son jti, pour la révocation.
model ScannerLink {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  jti         String    @unique @db.Uuid
  /// Nom du membre du staff (un lien par personne : on sait qui a scanné).
  label       String?   @db.VarChar(60)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  scanLogs  ScanLog[]

  @@index([eventId])
  @@map("scanner_links")
}

/// Journal de toutes les tentatives de scan, acceptées ou non.
model ScanLog {
  id            String     @id @default(uuid()) @db.Uuid
  scannerLinkId String     @map("scanner_link_id") @db.Uuid
  ticketId      String?    @map("ticket_id") @db.Uuid
  result        ScanResult
  scannedAt     DateTime   @default(now()) @map("scanned_at") @db.Timestamptz(3)

  scannerLink ScannerLink @relation(fields: [scannerLinkId], references: [id], onDelete: Restrict)
  ticket      Ticket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([scannerLinkId, scannedAt])
  @@index([ticketId])
  @@map("scan_logs")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @db.VarChar(20)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}
