# Copier en .env (jamais commité). Valeurs locales uniquement.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres local lancé par `pnpm db:up` (docker-compose.yml à la racine)
DATABASE_URL=postgresql://noise:noise@localhost:5432/noise_dev
# Base des tests d'intégration (jamais noise_dev). Port à adapter si NOISE_DB_PORT est défini.
TEST_DATABASE_URL=postgresql://noise:noise@localhost:5432/noise_test

# Origines autorisées (séparées par des virgules). Le mobile natif n'est pas concerné par CORS.
CORS_ORIGINS=http://localhost:5173

# Paiement (NOISE-017). `fake` : aucun appel réseau, scénario selon le numéro (voir docs/payments.md).
# `fedapay` : clé secrète et secret de webhook du tableau de bord FedaPay (sandbox en local).
PAYMENT_PROVIDER=fake
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Variables ajoutées par les tâches suivantes (ne pas remplir avant) :
# NOISE-007 : JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
# NOISE-012 : CLOUDINARY_URL
# NOISE-020 : QR_SIGNING_SECRET
# NOISE-024 : SCANNER_JWT_SECRET
