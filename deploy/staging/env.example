# Modèle du fichier /opt/noise-staging/.env sur le serveur de staging (NOISE-016).
# À copier sur le serveur et à remplir ; ne JAMAIS commiter le vrai fichier ni le coller dans une discussion.
# Générer un secret : openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48

# Nom public du serveur (sans https://). Sans nom de domaine : l'adresse IP avec des tirets + .sslip.io
STAGING_HOST=77-42-37-145.sslip.io

# Mot de passe de la base Postgres du staging. Caractères hexadécimaux : openssl rand -hex 24
POSTGRES_PASSWORD=

# Un secret distinct par variable (32 caractères minimum, tous différents).
JWT_ACCESS_SECRET=
QR_SIGNING_SECRET=
SCANNER_JWT_SECRET=

# Adresse de la page du scanner, sans le jeton : sert à fabriquer le lien partagé au staff.
SCANNER_URL=https://77-42-37-145.sslip.io/scan/

# Affiches et pièces d'identité (obligatoire en staging) : cloudinary://<clé>:<secret>@<nom>
# Pour un tout premier démarrage sans compte Cloudinary, cloudinary://x:y@z passe la validation,
# mais l'envoi des affiches échouera tant que la vraie valeur n'est pas renseignée.
CLOUDINARY_URL=

# Paiement. `fake` : faux fournisseur, aucun appel réseau (premier démarrage, tests de l'écran).
# Passer à `fedapay` dès que les clés de la sandbox FedaPay sont créées (NOISE-002) ; une clé live
# est refusée par l'API au démarrage en sandbox.
PAYMENT_PROVIDER=fake
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

LOG_LEVEL=info
