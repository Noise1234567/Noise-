{
  "name": "noise",
  "version": "0.0.0",
  "private": true,
  "description": "Noise — billetterie événementielle mobile pour Cotonou (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "pnpm --filter @noise/api dev",
    "dev:mobile": "pnpm --filter @noise/mobile start",
    "dev:scanner": "pnpm --filter @noise/scanner dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
